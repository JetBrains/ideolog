<idea-plugin package="com.intellij.ideolog.textmate">
  <dependencies>
    <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.editor.ex"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.textmate"/>
    <!-- endregion -->
  </dependencies>
  <extensions defaultExtensionNs="com.intellij.ideolog">
    <defaultLogEditorHighlighterProvider implementation="com.intellij.ideolog.textmate.highlighting.TextMateLogFileHighlighterProvider"/>
  </extensions>
</idea-plugin>
